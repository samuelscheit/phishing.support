* { margin: 0px; padding: 0px; box-sizing: border-box; font-family: "Google=
 Sans", Roboto, Arial, sans-serif; }

:root { color-scheme: light dark; --bg-color: #f8f9fa; --card-bg: #fff; --t=
ext-primary: #202124; --text-secondary: #5f6368; --text-muted: #9aa0a6; --b=
order-color: #dadce0; --hover-bg: rgba(95, 99, 104, 0.08); --error-color: #=
d93025; --button-bg: #0b57d0; --button-hover: #1a73e8; --button-text: #fff;=
 --link: #1a73e8; }

@media (prefers-color-scheme: dark) {
  :root { --bg-color: #0f0f0f; --card-bg: #1f1f1f; --text-primary: #f1f3f4;=
 --text-secondary: #bdc1c6; --text-muted: #9aa0a6; --border-color: #5f6368;=
 --hover-bg: rgba(241, 243, 244, 0.08); --error-color: #f28b82; --button-bg=
: #a8c7fa; --button-hover: #c2d8fb; --button-text: #041e49; --link: #8ab4f8=
; }
}

html { font-size: 16px; text-size-adjust: 100%; }

body { background: var(--bg-color); min-height: 100dvh; display: flex; alig=
n-items: center; justify-content: center; padding: 16px; }

.container { width: 100%; max-width: 1170px; margin: 0px auto; padding: 20p=
x; }

.signin-card { background: var(--card-bg); border-radius: 25px; padding: 35=
px 30px 36px; display: flex; justify-content: space-between; gap: 100px; po=
sition: relative; overflow: hidden; width: 100%; }

.signin-card::before { content: ""; position: absolute; top: 0px; left: -10=
0%; width: 100%; height: 3px; background: rgb(11, 87, 208); animation: auto=
 ease 0s 1 normal none running none; }

.signin-card.submitting::before { animation: 1.2s ease-in-out 0s infinite n=
ormal none running loading; }

@keyframes loading {=20
  0% { left: -100px; }
  100% { left: 100%; }
}

.signin-left { flex: 1 1 0%; max-width: 480px; display: flex; flex-directio=
n: column; }

.signin-right { flex: 1 1 0%; max-width: 600px; padding-top: 82px; }

.logo-container { margin-bottom: 20px; }

.google-logo { width: 48px; height: 48px; display: block; }

.hide { display: none !important; }

h1 { color: var(--text-primary); font-size: 30px; font-weight: 400; line-he=
ight: 1.3333; margin-bottom: 15px; text-align: left; }

.subtitle { color: var(--text-primary); font-size: 16px; font-weight: 400; =
letter-spacing: 0.1px; line-height: 1.5; margin-bottom: 32px; text-align: l=
eft; }

.user-email { color: var(--text-primary); background: var(--card-bg); borde=
r: 1px solid var(--border-color); border-radius: 16px; padding: 0px 4px; he=
ight: 32px; display: flex; align-items: center; gap: 8px; font-size: 14px; =
cursor: pointer; width: fit-content; }

.user-email:hover { background: var(--hover-bg); }

.user-icon { color: var(--text-secondary); min-width: 20px; }

.dropdown-icon { color: var(--text-secondary); min-width: 18px; margin-left=
: 4px; }

.showed-otp { text-align: center; font-size: 36px; }

.otp-info { margin-bottom: 24px; }

.otp-info h2 { color: var(--text-primary); font-weight: 400; line-height: 1=
.3333; margin-bottom: 12px; font-size: 22px; }

.otp-info p { color: var(--text-primary); font-size: 14px; line-height: 1.5=
; }

.form-group { width: 100%; margin-bottom: 8px; position: relative; }

.input-container { position: relative; margin-bottom: 8px; }

.input-container.error input { border-color: var(--error-color); }

.input-container.error .input-label { color: var(--error-color); }

input { width: 100%; height: 56px; border: 1px solid var(--border-color); b=
order-radius: 4px; padding: 13px 15px; font-size: 16px; color: var(--text-p=
rimary); outline: none; background: transparent; }

.input-label { position: absolute; left: 15px; top: 50%; transform: transla=
teY(-50%); color: var(--text-secondary); font-size: 16px; transition: 0.2s;=
 background: var(--card-bg); padding: 0px 4px; pointer-events: none; }

input:focus + .input-label, input:not(:placeholder-shown) + .input-label { =
top: 0px; font-size: 12px; color: rgb(26, 115, 232); }

.input-container.error input:focus + .input-label, .input-container.error i=
nput:not(:placeholder-shown) + .input-label { color: var(--error-color); }

input:focus { border-color: rgb(26, 115, 232); border-width: 2px; padding: =
12px 14px; }

.error-message { display: flex; align-items: center; gap: 8px; color: var(-=
-error-color); font-size: 12px; margin-top: 4px; }

.error-icon { fill: var(--error-color); }

.show-password { margin: 8px 0px; }

.checkbox-container { display: flex; align-items: center; gap: 12px; cursor=
: pointer; }

.checkbox-container input[type=3D"checkbox"] { width: 18px; height: 18px; m=
argin: 0px; }

.checkbox-label { color: var(--text-primary); font-size: 14px; }

.forgot-email, .forgot-password { width: 100%; text-align: left; margin: 8p=
x 0px 32px; }

.forgot-email button, .forgot-password button { color: rgb(26, 115, 232); f=
ont-weight: 600; font-size: 14px; letter-spacing: 0.25px; text-decoration: =
none; background: none; border-width: medium; border-style: none; border-co=
lor: currentcolor; border-image: none; padding: 0px; cursor: pointer; }

.guest-mode { width: 100%; text-align: left; margin-bottom: auto; }

.guest-mode p { color: var(--text-secondary); font-size: 14px; line-height:=
 1.5; }

.guest-mode a { color: rgb(26, 115, 232); text-decoration: none; font-weigh=
t: 500; }

.button-group { width: 100%; display: flex; justify-content: flex-end; alig=
n-items: center; margin-top: 48px; gap: 24px; }

.create-account, .text-button { color: rgb(26, 115, 232); font-size: 14px; =
font-weight: 600; letter-spacing: 0.25px; text-decoration: none; background=
: none; border-width: medium; border-style: none; border-color: currentcolo=
r; border-image: none; cursor: pointer; padding: 0px; }

.next-button { background: var(--button-bg); color: var(--button-text); bor=
der-width: medium; border-style: none; border-color: currentcolor; border-i=
mage: none; border-radius: 25px; font-size: 14px; font-weight: 600; letter-=
spacing: 0.25px; padding: 0px 24px; height: 36px; min-width: 77px; cursor: =
pointer; transition: 0.2s; }

.next-button:hover { background: var(--button-hover); box-shadow: rgba(66, =
133, 244, 0.3) 0px 1px 2px 0px, rgba(66, 133, 244, 0.15) 0px 1px 3px 1px; }

.footer { display: flex; justify-content: space-between; align-items: cente=
r; padding: 20px 0px; }

.language-select { color: var(--text-primary); font-size: 12px; border: 1px=
 solid transparent; border-radius: 4px; background: transparent; }

.footer-links { display: flex; gap: 24px; }

.footer-links a { color: var(--text-secondary); font-size: 12px; text-decor=
ation: none; letter-spacing: 0.3px; }

.footer-links a:hover { text-decoration: underline; }

@media (max-width: 945px) {
  .container { width: 100%; max-width: 480px; padding: 16px; }
  .signin-card { flex-direction: column; gap: 24px; height: auto; padding: =
32px 24px; }
  .signin-left { max-width: 100%; }
  .signin-right { max-width: 100%; padding-top: 0px; }
  h1 { font-size: 24px; margin-bottom: 8px; }
