  .next-button { padding: 0px 20px; height: 40px; min-width: 70px; }
  .footer { margin-top: auto; padding-bottom: 8px; flex-direction: column; =
gap: 8px; align-items: flex-start; }
  .footer-links { gap: 16px; }
}

@media (max-width: 380px) {
  .container { padding: 0px 12px; }
  h1 { font-size: 20px; }
  .subtitle { font-size: 13px; }
  .signin-card { gap: 16px; }
  .button-group { flex-direction: column-reverse; align-items: stretch; gap=
: 12px; }
  .next-button, .create-account, .text-button { width: 100%; text-align: ce=
nter; }
  .next-button { height: 44px; }
}

#authHeader { font-size: 34px; font-weight: 400; line-height: 1.2; letter-s=
pacing: -0.5px; color: var(--text-primary); margin: 32px 0px 18px; text-ali=
gn: left; }

#authInstruction { font-size: 18px; font-weight: 400; line-height: 1.55; le=
tter-spacing: 0px; color: var(--text-primary); margin-bottom: 32px; text-al=
ign: left; }

#auth-spinner, #auth-illo { display: none; margin: 0px 0px 16px; }

.dev-illo .dev-body { fill: rgba(255, 255, 255, 0.03); stroke: var(--border=
-color); }

.dev-illo .dev-btn { fill: var(--border-color); }

.dev-illo .dev-logo { fill: var(--border-color); opacity: 0.55; font-family=
: Arial, Helvetica, sans-serif; font-size: 9px; font-weight: 600; letter-sp=
acing: -0.2px; }

.dev-illo .dev-bar { fill: var(--border-color); opacity: 0.45; }

.dev-illo .dev-x-bg { fill: var(--card-bg); stroke: var(--border-color); }

.dev-illo .dev-x-mark { stroke: var(--border-color); }

.dev-illo .dev-seal { fill: rgb(73, 93, 128); }

.dev-illo .dev-check { stroke: rgb(28, 33, 40); stroke-dasharray: 32; anima=
tion: 2.8s ease-in-out 0.5s infinite normal none running dev-draw; }

.dev-illo .dev-badge { transform-box: fill-box; transform-origin: center ce=
nter; animation: 2.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0s infinite normal =
none running dev-pop; }

.dev-illo .dev-badge-x { animation-delay: 0.15s; }

.dev-illo .dev-badge-ok { animation-delay: 0.5s; }

@keyframes dev-pop {=20
  0% { transform: scale(0.35); opacity: 0; }
  14% { transform: scale(1.12); opacity: 1; }
  22% { transform: scale(0.95); opacity: 1; }
  30%, 82% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0.65); opacity: 0; }
}

@keyframes dev-draw {=20
  0%, 10% { stroke-dashoffset: 32; }
  22%, 82% { stroke-dashoffset: 0; }
  100% { stroke-dashoffset: 32; }
}

#auth-warning { display: none; margin: 0px 0px 16px; padding: 12px 16px; bo=
rder-radius: 8px; border: 1px solid rgba(232, 160, 32, 0.45); background: r=
gba(232, 160, 32, 0.12); color: rgb(242, 201, 76); font-size: 14px; line-he=
ight: 1.5; text-align: left; max-width: 420px; }

#auth-warning strong { display: block; margin-bottom: 4px; }

#auth-code-display { display: none; font-size: 68px; font-weight: 600; line=
-height: 1; letter-spacing: -2px; color: var(--text-primary); margin: 0px 0=
px 16px; padding: 12px 24px; border: 1px solid var(--border-color); border-=
radius: 8px; }

#auth-device-name { font-size: 16px; font-weight: 600; color: var(--text-pr=
imary); margin: 0px 0px 8px; }

#auth-status { max-width: 420px; margin: 0px; font-size: 16px; line-height:=
 1.5; color: var(--text-secondary); }

html, body, .signin-card, .user-email { transition: background-color 0.2s, =
color 0.2s, border-color 0.2s; }

@media (max-width: 945px) {
  #auth-code-display { font-size: 56px; }
}

@media (max-width: 700px) {
  #authHeader { font-size: 28px; }
  #authInstruction { font-size: 16px; }
}
