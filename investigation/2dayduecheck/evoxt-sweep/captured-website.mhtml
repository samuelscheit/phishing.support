 flex-direction: column; }
  .signin-card { padding: 24px 0px; height: auto; flex-direction: column; g=
ap: 20px; border-radius: 0px; flex: 1 1 0%; }
  .signin-left { max-width: 100%; flex: unset; }
  .signin-right { max-width: 100%; padding-top: 0px; }
  h1 { font-size: 22px; margin-bottom: 8px; }
  .subtitle { font-size: 14px; margin-bottom: 20px; }
  .logo-container { margin-bottom: 12px; }
  .google-logo { width: 40px; height: 40px; }
  input { height: 52px; font-size: 16px; }
  .button-group { margin-top: 24px; justify-content: space-between; gap: 8p=
